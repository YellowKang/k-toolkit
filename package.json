{
  "name": "k-toolkit",
  "version": "2.0.0",
  "description": "在线开发者工具箱 · 本地工具与 AI 助手 · 静态部署，无需登录",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YellowKang/k-toolkit.git"
  },
  "homepage": "https://github.com/YellowKang/k-toolkit#readme",
  "bugs": {
    "url": "https://github.com/YellowKang/k-toolkit/issues"
  },
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.cjs && node scripts/catalog-docs.js --check",
    "test:images": "node tests/image-tools.cjs",
    "test:catalog": "node tests/catalog-browser.cjs",
    "test:browser": "npm run test:images && npm run test:catalog && npm run test:workflows && npm run test:updates && npm run test:xss && npm run test:i18n && npm run test:totp && npm run test:backup && npm run test:ux && npm run test:performance && npm run test:quality && npm run test:json-workflow && npm run test:agent-ux && npm run test:agent-shared && npm run test:capabilities && npm run test:capabilities-next && npm run test:agent-library && npm run test:interaction-state",
    "docs:catalog": "node scripts/catalog-docs.js",
    "test:updates": "node tests/updates-browser.cjs",
    "test:workflows": "node tests/workflow-browser.cjs",
    "test:xss": "node tests/xss-browser.cjs",
    "test:i18n": "node tests/i18n-browser.cjs",
    "test:totp": "node tests/totp-browser.cjs",
    "test:backup": "node tests/backup-browser.cjs",
    "test:ux": "node tests/ux-browser.cjs",
    "test:performance": "node tests/performance-browser.cjs",
    "test:quality": "node tests/tool-quality-browser.cjs",
    "test:json-workflow": "node tests/json-workflow-browser.cjs",
    "test:agent-ux": "node tests/agent-ux-browser.cjs",
    "test:agent-shared": "node tests/agent-shared-browser.cjs",
    "test:capabilities": "node tests/capabilities-round2-browser.cjs",
    "test:capabilities-next": "node tests/capabilities-round3-browser.cjs",
    "test:agent-library": "node tests/agent-library-browser.cjs",
    "test:interaction-state": "node tests/interaction-state-browser.cjs"
  },
  "dependencies": {
    "express": "^4.18.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=20.13"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
